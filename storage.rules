rules_version = '2';

// =============================================================================================================
// Ductsal - Cloud Storage security rules. Applies to the confirmed canonical bucket: ductsal-erp.firebasestorage.app
//
// Everything requires a VALID SESSION (see the Firestore rules): custom claims { role, cid } plus an active CRM
// profile linked to the same Auth uid. Objects are write-once: no overwrite, no delete, no listing.
//
// Path families:
//   prod_files/prospects/{prospectId}/{folder}/{file}  documents of an opportunity / project
//   prod_files/clients/{cid}/identificacion/{file}     DUI attachment (visible to creator, privileged, active vendors)
//   prod_files/clients/{cid}/legal/{file}              Escrituras, Credenciales, NIT, NRC (creator, privileged, closing vendors)
//   prod_files/clients/{cid}/{file}                    direct client files (creator, privileged, reservation holder)
//   prod_files/{folder}/{file}                         LEGACY flat paths (transitional read) + fabricacion uploads
//   everything else (local_files/**, other buckets' paths ...)  denied
//
// LIMITS rules cannot fix (see CLIENT_CATALOG_AND_DEDUPE.md):
//  - download URLs with a token ("getDownloadURL") ignore these rules: links already stored in Firestore keep
//    working for anyone who has them until the object tokens are rotated;
//  - getDownloadURL() itself needs `get`, so uploads from a session that is not valid are rejected here.
// =============================================================================================================
service firebase.storage {
  match /b/{bucket}/o {

    function crmRoles()   { return ['manager', 'gestor', 'vendedor']; }
    function plantRoles() { return ['jefe_produccion', 'recepcion', 'dibujante', 'operario', 'encargado_armado', 'control_calidad', 'despacho']; }
    function role()       { return request.auth.token.get('role', ''); }
    function me()         { return request.auth.token.cid; }
    function hasProfile() {
      return request.auth != null
        && request.auth.token.get('cid', '') != ''
        && firestore.exists(/databases/(default)/documents/users_prod/$(request.auth.token.cid));
    }
    function profile() {
      return hasProfile()
        ? firestore.get(/databases/(default)/documents/users_prod/$(request.auth.token.cid)).data
        : null;
    }

    // Valid CRM session: Firebase Auth user linked via authUid in profile
    function validCrmSession() {
      return request.auth != null
        && request.auth.token.get('cid', '') != ''
        && role() in crmRoles()
        && profile() != null
        && profile().get('authUid', '') == request.auth.uid
        && profile().get('activo', false) == true
        && profile().get('role', '') == role();
    }

    // Valid Plant / Tablet session:
    // Supports real plant tablets (Custom Token from plantLogin: uid == 'plant_' + cid, claim plant == true, no authUid required in profile)
    // as well as web plant staff with Firebase Auth accounts (profile.authUid == request.auth.uid).
    function validPlantSession() {
      return request.auth != null
        && request.auth.token.get('cid', '') != ''
        && role() in plantRoles()
        && profile() != null
        && profile().get('activo', false) == true
        && profile().get('role', '') == role()
        && (
          (
            request.auth.token.get('plant', false) == true
            && request.auth.uid == 'plant_' + request.auth.token.cid
          )
          || (
            request.auth.token.get('plant', false) != true
            && profile().get('authUid', '') == request.auth.uid
          )
        );
    }

    function validSession() { return validCrmSession() || validPlantSession(); }
    function isManager()    { return validCrmSession() && role() == 'manager'; }
    function isGestor()     { return validCrmSession() && role() == 'gestor'; }
    function isPrivileged() { return validCrmSession() && (role() == 'manager' || role() == 'gestor'); }
    function isPlant()      { return validPlantSession() && role() in plantRoles(); }
    function isCrm()        { return validCrmSession() && role() in crmRoles(); }

    function hasProspect(pid) {
      return pid != null && pid != '' && firestore.exists(/databases/(default)/documents/prospects_prod/$(pid));
    }
    function getProspect(pid) {
      return hasProspect(pid)
        ? firestore.get(/databases/(default)/documents/prospects_prod/$(pid)).data
        : null;
    }
    function isPostclosing(d) {
      return d != null && (
        d.get('postcierre_habilitado', false) == true
        || (
          d.get('estado', '') != 'activo'
          && d.get('estado', '') != 'perdido'
          && (d.get('estado', '') == 'ganado' || d.get('fecha_cierre', '') != '' || d.get('facturas', []).size() > 0)
        )
      );
    }
    function canReadProspectDoc(p) {
      return p != null && (
        (isGestor() && (p.get('vendedorId', '') == me() || p.get('createdBy', '') == me() || isPostclosing(p)))
        || (role() == 'vendedor' && (p.get('vendedorId', '') == me() || (p.get('vendedorId', '') == '' && p.get('createdBy', '') == me())))
      );
    }
    function canReadProspect(pid) {
      return isManager() || (isCrm() && canReadProspectDoc(getProspect(pid)));
    }

    function canUploadToProspectDoc(p, folder) {
      return p != null && (
        (isGestor() && (
          isPostclosing(p)
            ? folder in ['facturas', 'pagos', 'ordenes_cambio']
            : ((p.get('vendedorId', '') == me() || p.get('createdBy', '') == me()) && folder in ['proyectos', 'facturas'])
        ))
        || (role() == 'vendedor' && (
          !isPostclosing(p)
          && (p.get('vendedorId', '') == me() || (p.get('vendedorId', '') == '' && p.get('createdBy', '') == me()))
          && folder in ['proyectos', 'facturas']
        ))
      );
    }
    function canUploadToProspect(pid, folder) {
      return isManager() || (isCrm() && canUploadToProspectDoc(getProspect(pid), folder));
    }

    function hasClient(cid) {
      return cid != null && cid != '' && firestore.exists(/databases/(default)/documents/clients_prod/$(cid));
    }
    function getClient(cid) {
      return hasClient(cid)
        ? firestore.get(/databases/(default)/documents/clients_prod/$(cid)).data
        : null;
    }
    function isClientOwner(cid) {
      let c = getClient(cid);
      return c != null && c.get('createdBy', '') == me();
    }
    function isClientAssigned(cid) {
      let c = getClient(cid);
      return c != null && c.get('vendedor_asignado', '') == me();
    }
    // Current responsible seller for the account:
    // - If vendedor_asignado is explicitly set, ONLY that assigned seller is the current responsible.
    // - Otherwise, if createdBy is set, falls back to createdBy.
    // - For legacy/historical accounts where both vendedor_asignado and createdBy are absent,
    //   falls back to the seller linked in visibleTo.
    function isClientCurrentResponsible(cid) {
      let c = getClient(cid);
      return c != null && (
        c.get('vendedor_asignado', '') == me()
        || (
          (c.get('vendedor_asignado', '') == '' || c.get('vendedor_asignado', null) == null)
          && (
            c.get('createdBy', '') == me()
            || ((c.get('createdBy', '') == '' || c.get('createdBy', null) == null) && (me() in c.get('visibleTo', [])))
          )
        )
      );
    }
    function isClientVisible(cid) {
      let c = getClient(cid);
      return c != null && (me() in c.get('visibleTo', []));
    }
    function isClientClosing(cid) {
      let c = getClient(cid);
      return c != null && (me() in c.get('closingVendors', []));
    }

    // Pre-creation upload reservations (issued by reserveClientForUpload
    // before clients_prod/{cid} exists).
    // Policy:
    // - While status == 'reserved' and not expired, the reserving seller may read (get)
    //   and upload (create) within the reserved client prefix.
    // - Once expired or cancelled, seller read/create access is revoked immediately.
    // - Privileged roles (manager/gestor) retain read access for administrative recovery/audit.
    function hasReservation(cid) {
      return cid != null && cid != '' && firestore.exists(/databases/(default)/documents/client_reservations_prod/$(cid));
    }
    function getReservation(cid) {
      return hasReservation(cid)
        ? firestore.get(/databases/(default)/documents/client_reservations_prod/$(cid)).data
        : null;
    }
    function isReservationOwner(cid) {
      let r = getReservation(cid);
      return r != null && r.get('createdBy', '') == me();
    }
    function isReservationValid(cid) {
      let r = getReservation(cid);
      return r != null
        && r.get('createdBy', '') == me()
        && r.get('status', '') == 'reserved'
        && (
          (r.get('expiresAt', null) != null && request.time < r.get('expiresAt', null))
          || (r.get('expiresAtMs', 0) > 0 && request.time.toMillis() < r.get('expiresAtMs', 0))
        );
    }
    function isAuthorizedClientUpload(cid) {
      return isPrivileged() || (isCrm() && (isClientCurrentResponsible(cid) || isClientVisible(cid) || isClientClosing(cid) || isReservationValid(cid) || cid == me()));
    }
    function isAuthorizedLegalAccess(cid) {
      return isPrivileged() || (isCrm() && (isClientCurrentResponsible(cid) || isClientClosing(cid) || isReservationValid(cid)));
    }
    function isAuthorizedLegalUpload(cid) {
      return isPrivileged() || (isCrm() && (isClientCurrentResponsible(cid) || isClientClosing(cid) || isReservationValid(cid)));
    }

    // Write-once: an upload over an existing object is refused. Real Storage already evaluates that as `update`
    // (denied below); the explicit condition also makes it hold in the emulator, which evaluates EVERY upload as `create`.
    function isNew() { return resource == null; }
    function knownProspectFolder(f) { return f in ['proyectos', 'facturas', 'pagos', 'ordenes_cambio']; }
    function plantFolder(f)         { return f in ['requerimientos', 'fabricacion_archivos']; }

    // SEC-05 H-05: Límites de tamaño segmentados por familia de ruta.
    // Solo las carpetas de proyectos y fabricación de planta permiten hasta 100 MiB (planos CAD, levantamientos, ZIPs).
    // Las carpetas administrativas y legales mantienen límites acotados para evitar abusos.
    function maxBytesForFolder(f) {
      return (f == 'proyectos' || plantFolder(f)) ? 100 * 1024 * 1024
           : f == 'ordenes_cambio'                ? 35 * 1024 * 1024
           : (f == 'legal' || f == 'poderes')     ? 25 * 1024 * 1024
           : (f == 'facturas' || f == 'clientes') ? 15 * 1024 * 1024
           : 10 * 1024 * 1024; // identificacion, pagos, etc.
    }
    function sizeOkFor(f) {
      return request.resource != null && request.resource.size <= maxBytesForFolder(f);
    }
    function sizeOk() { return request.resource != null && request.resource.size < 20 * 1024 * 1024; }

    // INC-UPLOAD-ALEJANDRA: Deny active/executable content while explicitly supporting Office, CAD, Revit & images.
    function typeOk() {
      return request.resource.contentType == null
        || !request.resource.contentType.matches('(?i).*(html|text/xml|application/xml|image/svg\\+xml|javascript|x-msdownload|x-sh|x-httpd-php).*');
    }

    // Explicit folder-scoped file extension whitelist:
    // - proyectos & plantFolder: Full technical & commercial dossier (CAD, Revit, PDF, Office, Images, ZIP).
    // - ordenes_cambio: Commercial addenda (PDF, Office, Images).
    // - facturas: Invoices & tax records (PDF, Images, Excel).
    // - identificacion, legal, poderes, pagos: Identity scans & banking receipts (PDF, Images).
    function allowedExtensionFor(f, file) {
      return (f == 'identificacion' || f == 'legal' || f == 'poderes' || f == 'pagos')
        ? file.matches('(?i).*\\.(pdf|jpg|jpeg|png|webp|tif|tiff)$')
        : (f == 'facturas')
        ? file.matches('(?i).*\\.(pdf|jpg|jpeg|png|webp|tif|tiff|xlsx|xls)$')
        : (f == 'ordenes_cambio')
        ? file.matches('(?i).*\\.(pdf|docx|doc|xlsx|xls|xlsm|jpg|jpeg|png|webp|tif|tiff)$')
        : file.matches('(?i).*\\.(pdf|xlsx|xls|xlsm|docx|doc|dwg|dxf|rvt|rfa|rte|rft|jpg|jpeg|png|webp|gif|tif|tiff|zip)$');
    }

    // ---------- Opportunity / project files (hierarchical) ----------
    match /prod_files/prospects/{pid}/{folder}/{file} {
      allow get: if canReadProspect(pid);
      allow create: if isNew() && knownProspectFolder(folder) && sizeOkFor(folder)
        && typeOk() && allowedExtensionFor(folder, file)
        && canUploadToProspect(pid, folder);
      allow list, update, delete: if false;
    }

    // ---------- Client: Identification / DUI files ----------
    match /prod_files/clients/{cid}/identificacion/{file} {
      allow get: if isPrivileged()
        || (isCrm() && (isClientCurrentResponsible(cid) || isClientVisible(cid) || isClientClosing(cid) || isReservationValid(cid)));
      allow create: if isNew() && sizeOkFor('identificacion')
        && typeOk() && allowedExtensionFor('identificacion', file)
        && isAuthorizedClientUpload(cid);
      allow list, update, delete: if false;
    }

    // ---------- Client: Sensitive Legal files (Escritura, Credencial, NIT, NRC) ----------
    match /prod_files/clients/{cid}/legal/{file} {
      allow get: if isAuthorizedLegalAccess(cid);
      allow create: if isNew() && sizeOkFor('legal')
        && typeOk() && allowedExtensionFor('legal', file)
        && isAuthorizedLegalUpload(cid);
      allow list, update, delete: if false;
    }

    // ---------- Client: Contract Powers files (Phase 2 Block B3) ----------
    match /prod_files/clients/{cid}/poderes/{file} {
      allow get: if isAuthorizedLegalAccess(cid);
      allow create: if isNew() && sizeOkFor('poderes')
        && typeOk() && allowedExtensionFor('poderes', file)
        && isAuthorizedLegalUpload(cid);
      allow list, update, delete: if false;
    }

    // ---------- Client: direct files (transitional / general client documents) ----------
    match /prod_files/clients/{cid}/{file} {
      allow get: if isPrivileged() || (isCrm() && (isClientCurrentResponsible(cid) || cid == me() || isReservationValid(cid)));
      allow create: if isNew() && sizeOkFor('clientes')
        && typeOk() && allowedExtensionFor('clientes', file)
        && isAuthorizedClientUpload(cid);
      allow list, update, delete: if false;
    }

    // ---------- Fabricacion & Legacy flat paths (transitional read, write restricted) ----------
    match /prod_files/{folder}/{file} {
      allow get: if isPrivileged()
        || isPlant()
        || (isCrm() && (knownProspectFolder(folder) || folder == 'clientes'));
      allow create: if isNew() && plantFolder(folder) && sizeOkFor(folder)
        && typeOk() && allowedExtensionFor(folder, file)
        && (isPrivileged() || isPlant());
      allow list, update, delete: if false;
    }

    // ---------- Default Deny ----------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
