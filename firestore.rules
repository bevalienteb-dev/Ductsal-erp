rules_version = '2';

// =============================================================================================================
// Ductsal CRM + fabricacion - Firestore security rules (PROPOSED, NOT DEPLOYED).
// Single source of truth: the emulator tests (functions/isolated-tests) load THIS file; the deploy must use it
// byte for byte (see functions/CLIENT_CATALOG_AND_DEDUPE.md, "Rules: tested = deployed").
//
// Identity: Firebase Auth custom claims { role, cid [, manager: true] } set only by Cloud Functions / the owner.
// `cid` is the historical commercial id (document id in users_prod); it is NEVER replaced by the Auth uid.
// Claims alone are not trusted: validSession() also requires the CRM profile to be linked to this Auth uid,
// active and with the same role, so a deactivation or role change takes effect immediately.
// An Auth account created by anyone (open sign-up) has no claims and gets nothing.
//
// Everything not matched below is denied: userOps*, userOpsLocks*, clientIdentifiers*, clientOps*, *_local,
// un-suffixed legacy collections and anything new.
// =============================================================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- session helpers ----------
    function crmRoles()   { return ['manager', 'gestor', 'vendedor']; }
    function plantRoles() { return ['jefe_produccion', 'recepcion', 'dibujante', 'operario', 'encargado_armado', 'control_calidad', 'despacho']; }
    function role()       { return request.auth.token.get('role', ''); }
    function hasClaims() {
      return request.auth != null
        && request.auth.token.get('cid', '') != ''
        && (role() in crmRoles() || role() in plantRoles());
    }
    function me() { return request.auth.token.cid; }
    function myProfile() {
      return get(/databases/$(database)/documents/users_prod/$(request.auth.token.cid)).data;
    }
    function validSession() {
      return hasClaims()
        && myProfile().authUid == request.auth.uid
        && myProfile().activo == true
        && myProfile().role == role();
    }
    function isManager() {
      return validSession() && role() == 'manager' && request.auth.token.get('manager', false) == true;
    }
    function isGestor()     { return validSession() && role() == 'gestor'; }
    function isVendedor()   { return validSession() && role() == 'vendedor'; }
    function isPrivileged() { return isManager() || isGestor(); }
    function isPlant()      { return validSession() && role() in plantRoles(); }
    function isJefe()       { return validSession() && role() == 'jefe_produccion'; }

    // ---------- users: written ONLY by Cloud Functions (Admin SDK) ----------
    match /users_prod/{userId} {
      allow get: if validSession() && (isManager() || userId == me());
      allow list: if isManager();
      allow write: if false;
    }
    // Password-free directory (id, nombre, role, activo) kept by Cloud Functions, for assignment lists.
    match /userDirectory_prod/{userId} {
      allow read: if validSession();
      allow write: if false;
    }

    // ---------- clients ----------
    // Portfolio of a vendedor = clients they created + clients linked (clientId) to opportunities they created or
    // are assigned to. `visibleTo` is that second set, maintained ONLY by the syncClientVisibility triggers.
    // The CATALOGUE (selecting any client for a new opportunity) is NOT a Firestore read: it is the
    // searchClientsCatalog callable, which returns id / name / masked hint only.
    function clientVisible(d) {
      return isPrivileged()
        || (isVendedor() && (d.createdBy == me() || me() in d.get('visibleTo', [])));
    }
    // Identity fields (type, NIT, DUI) can only change through updateClientAdmin, which keeps the
    // clientIdentifiers index consistent. Clients are created ONLY through createClientAdmin.
    function identityKept() {
      return request.resource.data.get('nit', '') == resource.data.get('nit', '')
        && request.resource.data.get('dui', '') == resource.data.get('dui', '')
        && request.resource.data.get('tipo', '') == resource.data.get('tipo', '');
    }
    match /clients_prod/{clientId} {
      allow get, list: if clientVisible(resource.data);
      allow create: if false;
      allow update: if (isPrivileged() || (isVendedor() && clientVisible(resource.data)))
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.get('visibleTo', null) == resource.data.get('visibleTo', null)
        && identityKept();
      allow delete: if false;         // SEC-06: Direct deletion disabled; must go exclusively through deleteClientAdmin (atomic index release & audit)
    }

    // ---------- prospects (opportunities / projects) ----------
    function prospectMine(d) {
      return d.createdBy == me() || d.get('vendedorId', '') == me();
    }
    function flag(d, k) { return d.get('datos', {}).get(k, null); }
    // "Sale authorised without contract" is a manager decision: nobody else may change it.
    function noContractFlagsKept() {
      return flag(request.resource.data, 'autorizado_sin_contrato') == flag(resource.data, 'autorizado_sin_contrato')
        && flag(request.resource.data, 'autorizado_por') == flag(resource.data, 'autorizado_por');
    }
    match /prospects_prod/{prospectId} {
      allow get, list: if isPrivileged() || (isVendedor() && prospectMine(resource.data));
      // Any existing client may be chosen (catalogue). Choosing a client never changes the client's createdBy.
      allow create: if (isPrivileged() || isVendedor())
        && request.resource.data.id == prospectId
        && request.resource.data.createdBy == me()
        && (isPrivileged() || request.resource.data.get('vendedorId', '') == me())
        && (isManager() || flag(request.resource.data, 'autorizado_sin_contrato') == null)
        && exists(/databases/$(database)/documents/clients_prod/$(request.resource.data.clientId));
      // SEC-04: Direct updates bypass server validation, audit logs, and closingVendors tracking.
      // All modifications (stages, prices, reassignments, logs, invoices, payments) MUST go through Cloud Functions.
      allow update: if false;
      // SEC-04 / SEC-06: Direct physical deletion is disabled. Logical deletion goes through deleteProspectAdmin (motivo, audit log, manufacturing preservation).
      allow delete: if false;
    }

    // ---------- settings / audit ----------
    match /system_prod/{docId} {
      allow read: if validSession();
      allow write: if isManager() || isJefe();
    }
    // append-only; readable by managers only. (Target: written by the server so `usuario` cannot be forged.)
    match /audit_logs_prod/{logId} {
      allow read: if isManager();
      allow create: if validSession() && request.resource.data.keys().size() <= 20;
      allow update, delete: if false;
    }

    // ---------- fabricacion + tablets (DESIGN: role-level, to refine with the plant flows) ----------
    // Plant roles get NO access to clients / prospects: operador.html never reads them, and the fabricacion
    // views must carry the project names they need inside proyectos_fabricacion.
    match /fabricacion_prod/{docId} {
      allow read: if isManager() || isGestor() || isPlant();
      allow create, update: if isManager() || (isPlant() && role() in ['jefe_produccion', 'recepcion', 'dibujante']);
      allow delete: if isManager() || isJefe();
    }
    match /fabricacion_tasks_prod/{docId} {
      allow read: if isManager() || isGestor() || isPlant();
      allow create, delete: if isManager() || isJefe();
      allow update: if isManager() || isPlant();   // operators advance their tasks
    }
    match /proyectos_fabricacion_prod/{docId} {
      allow read: if isManager() || isGestor() || isPlant();
      allow create, update: if isManager() || isGestor() || isJefe();
      allow delete: if isManager() || isJefe();
    }
    match /bobinas_soldadura_prod/{docId} {
      allow read: if isManager() || isPlant();
      allow write: if isManager() || (isPlant() && role() in ['jefe_produccion', 'operario', 'encargado_armado']);
    }
    // NOTE: `config` and `alertas_maquinas` have no environment suffix in the code (shared by local and prod).
    match /config/{docId} {
      allow read: if isManager() || isGestor() || isPlant();
      allow write: if isManager() || isJefe();
    }
    match /config/estado_equipos {
      allow write: if isManager() || isPlant();   // machine status reported from the tablets
    }
    match /alertas_maquinas/{alertId} {
      allow read: if isManager() || isPlant();
      allow create: if isManager() || isPlant();
      allow update: if isManager() || isJefe();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
