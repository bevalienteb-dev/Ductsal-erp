rules_version = '2';

// =============================================================================================================
// Ductsal CRM + fabricacion - Firestore security rules (PROPOSED, NOT DEPLOYED).
// Single source of truth: the emulator tests (functions/isolated-tests) load THIS file; the deploy must use it
// byte for byte (see functions/CLIENT_CATALOG_AND_DEDUPE.md, "Rules: tested = deployed").
//
// Identity: Firebase Auth custom claims { role, cid [, manager: true] } set only by Cloud Functions / the owner.
// `cid` is the historical commercial id (document id in users_prod); it is NEVER replaced by the Auth uid.
// Claims alone are not trusted: validSession() also requires the CRM profile to be linked to this Auth uid,
// active and with the same role, so a deactivation or role change takes effect immediately.
// An Auth account created by anyone (open sign-up) has no claims and gets nothing.
//
// Everything not matched below is denied: userOps*, userOpsLocks*, clientIdentifiers*, clientOps*, *_local,
// un-suffixed legacy collections and anything new.
// =============================================================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- session helpers ----------
    function crmRoles()   { return ['manager', 'gestor', 'vendedor']; }
    function plantRoles() { return ['jefe_produccion', 'recepcion', 'dibujante', 'operario', 'encargado_armado', 'control_calidad', 'despacho']; }
    function role()       { return request.auth.token.get('role', ''); }
    function hasClaims() {
      return request.auth != null
        && request.auth.token.get('cid', '') != ''
        && (role() in crmRoles() || role() in plantRoles());
    }
    function me() { return request.auth.token.cid; }
    function myProfile() {
      return get(/databases/$(database)/documents/users_prod/$(request.auth.token.cid)).data;
    }
    function validSession() {
      return hasClaims()
        && myProfile().authUid == request.auth.uid
        && myProfile().activo == true
        && myProfile().role == role();
    }
    function isManager() {
      return validSession() && role() == 'manager' && request.auth.token.get('manager', false) == true;
    }
    function isGestor()     { return validSession() && role() == 'gestor'; }
    function isVendedor()   { return validSession() && role() == 'vendedor'; }
    function isPrivileged() { return isManager() || isGestor(); }
    function isPlant()      { return validSession() && role() in plantRoles(); }
    function isJefe()       { return validSession() && role() == 'jefe_produccion'; }

    // ---------- users: written ONLY by Cloud Functions (Admin SDK) ----------
    match /users_prod/{userId} {
      allow get: if validSession() && (isManager() || userId == me());
      allow list: if isManager();
      allow write: if false;
    }
    // Password-free directory (id, nombre, role, activo) kept by Cloud Functions, for assignment lists.
    match /userDirectory_prod/{userId} {
      allow read: if validSession();
      allow write: if false;
    }

    // ---------- clients ----------
    // Portfolio of a vendedor = clients they created + clients linked (clientId) to opportunities they created or
    // are assigned to. `visibleTo` is that second set, maintained ONLY by the syncClientVisibility triggers.
    // The CATALOGUE (selecting any client for a new opportunity) is NOT a Firestore read: it is the
    // searchClientsCatalog callable, which returns id / name / masked hint only.
    function clientVisible(d) {
      return isPrivileged()
        || (isVendedor() && (d.createdBy == me() || me() in d.get('visibleTo', []) || d.get('vendedor_asignado', '') == me()));
    }
    // Identity fields (type, NIT, DUI) can only change through updateClientAdmin, which keeps the
    // clientIdentifiers index consistent. Clients are created ONLY through createClientAdmin.
    function identityKept() {
      return request.resource.data.get('nit', '') == resource.data.get('nit', '')
        && request.resource.data.get('dui', '') == resource.data.get('dui', '')
        && request.resource.data.get('tipo', '') == resource.data.get('tipo', '');
    }
    // Phase 2 Block B3 & SEC-10: Sensitive legal, assignment, visibility and backend-controlled projection
    // fields on clients_prod must ONLY be mutated through authorized backend callables (Admin SDK),
    // never via direct client-side Firestore writes.
    function protectedClientFieldsKept() {
      return request.resource.data.get('closingVendors', null) == resource.data.get('closingVendors', null)
        && request.resource.data.get('vendedor_asignado', null) == resource.data.get('vendedor_asignado', null)
        && request.resource.data.get('representanteLegalVigente', null) == resource.data.get('representanteLegalVigente', null)
        && request.resource.data.get('apoderadosVigentes', null) == resource.data.get('apoderadosVigentes', null)
        && request.resource.data.get('biennialReviews', null) == resource.data.get('biennialReviews', null)
        && request.resource.data.get('documentos', null) == resource.data.get('documentos', null);
    }
    match /clients_prod/{clientId} {
      allow get, list: if clientVisible(resource.data);
      allow create: if false;
      allow update: if (isPrivileged() || (isVendedor() && clientVisible(resource.data)))
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.get('visibleTo', null) == resource.data.get('visibleTo', null)
        && identityKept()
        && protectedClientFieldsKept();
      allow delete: if false;         // SEC-06: Direct deletion disabled; must go exclusively through deleteClientAdmin (atomic index release & audit)

      match /document_versions/{versionId} {
        allow get, list: if clientVisible(get(/databases/$(database)/documents/clients_prod/$(clientId)).data);
        allow write: if false;
      }

      match /legal_representative_terms/{termId} {
        allow get, list: if clientVisible(get(/databases/$(database)/documents/clients_prod/$(clientId)).data);
        allow write: if false;
      }

      match /contract_powers/{powerId} {
        allow get, list: if clientVisible(get(/databases/$(database)/documents/clients_prod/$(clientId)).data);
        allow write: if false;
      }

      match /biennial_confirmations/{confId} {
        allow get, list: if clientVisible(get(/databases/$(database)/documents/clients_prod/$(clientId)).data);
        allow write: if false;
      }
    }

    // ---------- contacts (persons and account relations - Phase 2 Block 1) ----------
    match /contacts_prod/{contactId} {
      allow get, list: if isPrivileged();
      allow write: if false;
    }

    match /account_contacts_prod/{accountContactId} {
      allow get, list: if isPrivileged() || (isVendedor() && clientVisible(get(/databases/$(database)/documents/clients_prod/$(resource.data.accountId)).data));
      allow write: if false;

      match /periods_prod/{periodId} {
        allow get, list: if isPrivileged() || (isVendedor() && clientVisible(get(/databases/$(database)/documents/clients_prod/$(resource.data.accountId)).data));
        allow write: if false;
      }
    }

    // ---------- prospects (opportunities / projects) ----------
    function prospectMine(d) {
      return d.get('vendedorId', '') == me()
        || (d.get('vendedorId', '') == '' && d.createdBy == me());
    }
    function isPostclosing(d) {
      return d != null && (
        d.get('postcierre_habilitado', false) == true
        || (
          d.get('estado', '') != 'activo'
          && d.get('estado', '') != 'perdido'
          && (d.get('estado', '') == 'ganado' || d.get('fecha_cierre', '') != '' || d.get('facturas', []).size() > 0)
        )
      );
    }
    function prospectVisible(d) {
      return isManager()
        || (isGestor() && (d.get('vendedorId', '') == me() || d.createdBy == me() || isPostclosing(d)))
        || (isVendedor() && prospectMine(d));
    }
    function flag(d, k) { return d.get('datos', {}).get(k, null); }
    // "Sale authorised without contract" is a manager decision: nobody else may change it.
    function noContractFlagsKept() {
      return flag(request.resource.data, 'autorizado_sin_contrato') == flag(resource.data, 'autorizado_sin_contrato')
        && flag(request.resource.data, 'autorizado_por') == flag(resource.data, 'autorizado_por');
    }
    match /prospects_prod/{prospectId} {
      allow get, list: if prospectVisible(resource.data);
      // Any existing client may be chosen (catalogue). Choosing a client never changes the client's createdBy.
      allow create: if (isManager() || isGestor() || isVendedor())
        && request.resource.data.id == prospectId
        && request.resource.data.createdBy == me()
        && (isPrivileged() || request.resource.data.get('vendedorId', '') == me())
        && (isManager() || flag(request.resource.data, 'autorizado_sin_contrato') == null)
        && exists(/databases/$(database)/documents/clients_prod/$(request.resource.data.clientId));
      // SEC-04: Direct updates bypass server validation, audit logs, and closingVendors tracking.
      // All modifications (stages, prices, reassignments, logs, invoices, payments) MUST go through Cloud Functions.
      allow update: if false;
      // SEC-04 / SEC-06: Direct physical deletion is disabled. Logical deletion goes through deleteProspectAdmin (motivo, audit log, manufacturing preservation).
      allow delete: if false;

      match /document_versions/{versionId} {
        allow get, list: if prospectVisible(get(/databases/$(database)/documents/prospects_prod/$(prospectId)).data);
        allow write: if false;
      }
    }

    // ---------- opportunity contacts and roles (Phase 2 Block 2) ----------
    match /opportunity_contact_roles_prod/{roleId} {
      allow get, list: if validSession();
      allow write: if false;
    }

    match /opportunity_contacts_prod/{ocId} {
      allow get, list: if isPrivileged() || (isVendedor() && prospectVisible(get(/databases/$(database)/documents/prospects_prod/$(resource.data.opportunityId)).data));
      allow write: if false;
    }

    // ---------- settings / audit ----------
    match /system_prod/{docId} {
      allow read: if validSession();
      allow write: if isManager() || isJefe();
    }
    // append-only; readable by managers only. (Target: written by the server so `usuario` cannot be forged.)
    match /audit_logs_prod/{logId} {
      allow read: if isManager();
      allow create: if validSession() && request.resource.data.keys().size() <= 20;
      allow update, delete: if false;
    }

    // ---------- fabricacion + tablets (DESIGN: role-level, hardened with backend authorization gates) ----------
    // Plant roles get NO access to clients / prospects: operador.html never reads them, and the fabricacion
    // views must carry the project names they need inside proyectos_fabricacion.
    // All order creation, project creation/updates, task generation, and pre-fabrication -> Fabricación releases
    // MUST go through Cloud Functions Admin SDK (sendProspectToFabricationAdmin / validateAndAuthorizeFabricationOrderAdmin).
    function fabOrderProtectedFieldsUnchanged() {
      return request.resource.data.get('prospecto_id', null) == resource.data.get('prospecto_id', null)
        && request.resource.data.get('padre_id', null) == resource.data.get('padre_id', null)
        && request.resource.data.get('origen_tipo', null) == resource.data.get('origen_tipo', null)
        && request.resource.data.get('codigo_proyecto', null) == resource.data.get('codigo_proyecto', null)
        && request.resource.data.get('estado_habilitacion_fabricacion', null) == resource.data.get('estado_habilitacion_fabricacion', null)
        && request.resource.data.get('autorizado_backend', null) == resource.data.get('autorizado_backend', null)
        && request.resource.data.get('liberado_a_fabricacion_backend', null) == resource.data.get('liberado_a_fabricacion_backend', null)
        && request.resource.data.get('discrepancia_financiera', false) == resource.data.get('discrepancia_financiera', false)
        && request.resource.data.get('bloqueado_avance_etapa', false) == resource.data.get('bloqueado_avance_etapa', false)
        && request.resource.data.get('excepcion_legado_verificada', null) == resource.data.get('excepcion_legado_verificada', null)
        && request.resource.data.get('origen_excepcion_legado', null) == resource.data.get('origen_excepcion_legado', null)
        && request.resource.data.get('fecha_excepcion_legado', null) == resource.data.get('fecha_excepcion_legado', null)
        && request.resource.data.get('autorizado_excepcion_legado_por', null) == resource.data.get('autorizado_excepcion_legado_por', null);
    }
    function fabOrderOperationalUpdateAllowed() {
      return fabOrderProtectedFieldsUnchanged()
        && resource.data.get('bloqueado_avance_etapa', false) != true
        && (
          (
            resource.data.get('etapa', '') in ['', 'Recepción', 'Dibujo']
            && (isManager() || (isPlant() && role() in ['jefe_produccion', 'recepcion', 'dibujante']))
            && request.resource.data.get('etapa', '') in ['', 'Recepción', 'Dibujo']
            && resource.data.get('discrepancia_financiera', false) != true
            && resource.data.get('estado_habilitacion_fabricacion', '') != 'ANTICIPO_PENDIENTE'
          )
          || (
            !(resource.data.get('etapa', '') in ['', 'Recepción', 'Dibujo'])
            && (isManager() || isPlant())
            && !(request.resource.data.get('etapa', '') in ['', 'Recepción', 'Dibujo'])
            && (
              resource.data.get('liberado_a_fabricacion_backend', false) == true
              || (
                resource.data.get('excepcion_legado_verificada', false) == true
                && resource.data.get('origen_excepcion_legado', null) is string
                && resource.data.get('origen_excepcion_legado', '').size() > 0
              )
            )
          )
        );
    }
    match /fabricacion_prod/{docId} {
      allow read: if isManager() || isGestor() || isPlant();
      allow create: if false;
      allow update: if fabOrderOperationalUpdateAllowed();
      allow delete: if isManager() || isJefe();
    }
    match /fabricacion_tasks_prod/{docId} {
      allow read: if isManager() || isGestor() || isPlant();
      allow create: if false;
      allow update: if (isManager() || isPlant())
        && request.resource.data.get('fabricacion_id', null) == resource.data.get('fabricacion_id', null)
        && request.resource.data.get('creada_en_backend', null) == resource.data.get('creada_en_backend', null)
        && request.resource.data.get('excepcion_legado_verificada', null) == resource.data.get('excepcion_legado_verificada', null)
        && request.resource.data.get('origen_excepcion_legado', null) == resource.data.get('origen_excepcion_legado', null);
      allow delete: if isManager() || isJefe();
    }
    match /proyectos_fabricacion_prod/{docId} {
      allow read: if isManager() || isGestor() || isPlant();
      allow create, update: if false;
      allow delete: if isManager() || isJefe();
    }
    match /bobinas_soldadura_prod/{docId} {
      allow read: if isManager() || isPlant();
      allow write: if isManager() || (isPlant() && role() in ['jefe_produccion', 'operario', 'encargado_armado']);
    }
    // NOTE: `config` and `alertas_maquinas` have no environment suffix in the code (shared by local and prod).
    match /config/{docId} {
      allow read: if isManager() || isGestor() || isPlant();
      allow write: if isManager() || isJefe();
    }
    match /config/estado_equipos {
      allow write: if isManager() || isPlant();   // machine status reported from the tablets
    }
    match /alertas_maquinas/{alertId} {
      allow read: if isManager() || isPlant();
      allow create: if isManager() || isPlant();
      allow update: if isManager() || isJefe();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
